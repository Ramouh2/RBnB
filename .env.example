# RBnB — variables d'environnement (copier vers .env.local)

# Secret de signature des sessions (≥ 32 caractères). OBLIGATOIRE en production.
# Générer : openssl rand -base64 32
RBNB_AUTH_SECRET=

# Compte de démonstration (défauts : demo@rbnb.app / rbnb-demo-2026)
RBNB_DEMO_EMAIL=demo@rbnb.app
RBNB_DEMO_PASSWORD=rbnb-demo-2026

# URL publique (métadonnées SEO / OpenGraph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
